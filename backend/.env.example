# ============================================
# Predicta - Environment Configuration
# Copy this file to `.env` and fill in real values
# NEVER commit the real `.env` file
# Every variable is declared in app/core/config.py
# ============================================

# Database connection string (PostgreSQL)
# Use psycopg2 because requirements.txt installs psycopg2-binary.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
# Production requires ?sslmode=require (or verify-ca / verify-full);
# Neon's channel_binding=require is accepted too.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/predicta_db

# JWT secret key - generate with: openssl rand -hex 32
# Production refuses this placeholder and anything under 32 characters.
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# JWT expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# development, test or production. Unset means production, which hides
# /docs, /redoc and /openapi.json and adds Strict-Transport-Security.
ENVIRONMENT=development

# CORS allowed origins, comma-separated. Default: http://localhost:5173.
# "*" is accepted only with ENVIRONMENT=development.
CORS_ORIGINS=http://localhost:5173

# Log level: DEBUG, INFO, WARNING or ERROR
LOG_LEVEL=INFO

# Maximum rows accepted per uploaded file
MAX_UPLOAD_ROWS=200000

# Proxies whose X-Forwarded-For header gives the client IP for rate limits,
# comma-separated IPs or networks. Default: 127.0.0.1. Any other sender's
# X-Forwarded-For is ignored. "*" is safe only when the app is reachable
# solely through the provider's proxy (Railway); see docs/despliegue.md.
TRUSTED_PROXIES=127.0.0.1

# E-mail. "console" writes each message to the log (development and tests);
# "smtp" sends it with STARTTLS (needs SMTP_HOST, SMTP_USER, SMTP_PASSWORD);
# "brevo_api" sends it through Brevo's HTTPS API (needs BREVO_API_KEY), for
# hosts that block outbound SMTP such as Railway Hobby. Production requires
# smtp or brevo_api, plus EMAIL_FROM. See docs/despliegue.md.
EMAIL_BACKEND=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Brevo: SMTP & API -> API Keys (not the SMTP key)
BREVO_API_KEY=
EMAIL_FROM=Predicta <no-responder@example.com>
# Frontend address used in e-mailed links; https:// in production.
FRONTEND_URL=http://localhost:5173
