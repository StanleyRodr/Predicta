# ============================================
# Predicta - Environment Configuration
# Copy this file to `.env` and fill in real values
# NEVER commit the real `.env` file
# ============================================

# Database connection string (PostgreSQL)
# Use psycopg2 because requirements.txt installs psycopg2-binary.
# Format: postgresql+psycopg2://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@localhost:5432/predicta_db

# JWT secret key - generate with: openssl rand -hex 32
SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL

# JWT expiration time in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS allowed origins (comma-separated, or "*" for development only)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
